<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mobile_navigation"
    app:startDestination="@+id/nav_login">

    <fragment
        android:id="@+id/nav_login"
        android:name="com.example.minicex.ui.auth.LoginFragment"
        android:label="Iniciar Sesión"
        tools:layout="@layout/fragment_login">
        <action
            android:id="@+id/action_login_to_home"
            app:destination="@id/nav_home"
            app:popUpTo="@id/nav_login"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/nav_home"
        android:name="com.example.minicex.ui.home.HomeFragment"
        android:label="Inicio"
        tools:layout="@layout/fragment_home">
        <action
            android:id="@+id/action_home_to_evaluation"
            app:destination="@id/nav_evaluation" />
    </fragment>

    <fragment
        android:id="@+id/nav_evaluation"
        android:name="com.example.minicex.ui.evaluation.EvaluationFragment"
        android:label="Nueva Evaluación"
        tools:layout="@layout/fragment_evaluation">
        <action
            android:id="@+id/action_evaluation_to_results"
            app:destination="@id/nav_results"
            app:popUpTo="@id/nav_home" />
    </fragment>

    <fragment
        android:id="@+id/nav_results"
        android:name="com.example.minicex.ui.results.ResultsFragment"
        android:label="Resultado"
        tools:layout="@layout/fragment_results">
        <action
            android:id="@+id/action_results_to_home"
            app:destination="@id/nav_home"
            app:popUpTo="@id/nav_home"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/nav_evaluation_detail"
        android:name="com.example.minicex.ui.results.EvaluationDetailFragment"
        android:label="Detalle de Evaluación"
        tools:layout="@layout/fragment_evaluation_detail" />

    <fragment
        android:id="@+id/nav_settings"
        android:name="com.example.minicex.ui.settings.SettingsFragment"
        android:label="Ajustes"
        tools:layout="@layout/fragment_settings" />

    <fragment
        android:id="@+id/nav_reports"
        android:name="com.example.minicex.ui.reports.ReportsFragment"
        android:label="Reportes"
        tools:layout="@layout/fragment_reports" />

</navigation>
