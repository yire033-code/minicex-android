<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        app:elevation="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="32dp"
            android:paddingBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="REPORTES"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:letterSpacing="0.08"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvReportsTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Análisis de Evaluaciones"
                android:textColor="@color/on_surface"
                android:textSize="26sp"
                android:fontFamily="sans-serif-condensed-medium"
                android:textStyle="bold"
                android:layout_marginBottom="16dp" />

            <!-- Mode Toggle -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardModeToggle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/card_bg"
                app:strokeColor="@color/card_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="12dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Modo:"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnToggleMode"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:text="Resumen Docente"
                        android:textAllCaps="false"
                        android:textSize="13sp"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        app:iconTint="@color/primary"
                        app:strokeColor="@color/primary" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Student Selector Card (visible in PER_STUDENT mode) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardStudentSelector"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/card_bg"
                app:strokeColor="@color/card_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Seleccionar Alumno"
                        android:textColor="@color/primary"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.05"
                        android:layout_marginBottom="12dp" />

                    <Spinner
                        android:id="@+id/spStudentReports"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:background="@drawable/spinner_bg"
                        android:paddingHorizontal="16dp"
                        android:popupBackground="@color/surface" />

                    <TextView
                        android:id="@+id/tvReportOfflineMsg"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Se requiere conexión a internet para generar reportes"
                        android:textColor="@color/error"
                        android:textSize="12sp"
                        android:visibility="gone"
                        android:layout_marginTop="10dp" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Teacher Summary Header (visible in TEACHER_SUMMARY mode) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardSummaryHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/card_bg"
                app:strokeColor="@color/card_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="RESUMEN DEL DOCENTE"
                            android:textColor="@color/primary"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.05" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnModoTeacher"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:text="Mis evaluaciones"
                            android:textAllCaps="false"
                            android:textSize="11sp"
                            style="@style/Widget.MaterialComponents.Button.TextButton"
                            app:icon="@drawable/ic_reports"
                            app:iconTint="@color/primary"
                            android:letterSpacing="0" />
                    </LinearLayout>

                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:scrollbars="none"
                        android:clipToPadding="false">

                        <LinearLayout
                            android:id="@+id/layoutTeacherStats"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal" />
                    </HorizontalScrollView>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal"
                        android:gravity="center">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnViewerFullScreen"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:text="Ver en Pantalla Completa"
                            android:textAllCaps="false"
                            android:textSize="11sp"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            app:icon="@drawable/ic_reports"
                            app:iconTint="@color/primary"
                            app:strokeColor="@color/primary" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnExportTeacherExcel"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:text="Descargar .xlsx"
                            android:textAllCaps="false"
                            android:textSize="11sp"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            app:icon="@drawable/ic_download"
                            app:iconTint="@color/primary"
                            app:strokeColor="@color/primary" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollReportContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingBottom="96dp">

            <!-- Summary Stats -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardStats"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/card_bg"
                app:strokeColor="@color/card_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="RESUMEN GENERAL"
                            android:textColor="@color/primary"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.05" />

                        <ImageButton
                            android:id="@+id/btnExpandStats"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="?selectableItemBackgroundBorderless"
                            android:src="@drawable/ic_expand"
                            android:contentDescription="Expandir"
                            android:padding="6dp" />
                    </LinearLayout>

                    <HorizontalScrollView
                        android:id="@+id/hsvStats"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:scrollbars="none"
                        android:clipToPadding="false">

                        <LinearLayout
                            android:id="@+id/layoutReportStats"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal" />
                    </HorizontalScrollView>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Improvement Indices -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardIndices"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/card_bg"
                app:strokeColor="@color/card_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="14dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="ÍNDICES DE MEJORA"
                            android:textColor="@color/primary"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.05" />

                        <ImageButton
                            android:id="@+id/btnExpandIndices"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="?selectableItemBackgroundBorderless"
                            android:src="@drawable/ic_expand"
                            android:contentDescription="Expandir"
                            android:padding="6dp" />
                    </LinearLayout>

                    <GridLayout
                        android:id="@+id/gridIndices"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:columnCount="2" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Evolution Chart -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardChartEvolution"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/card_bg"
                app:strokeColor="@color/card_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="EVOLUCIÓN DE CALIFICACIONES"
                            android:textColor="@color/primary"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.05" />

                        <ImageButton
                            android:id="@+id/btnExpandEvolution"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="?selectableItemBackgroundBorderless"
                            android:src="@drawable/ic_expand"
                            android:contentDescription="Expandir"
                            android:padding="6dp" />
                    </LinearLayout>

                    <com.github.mikephil.charting.charts.LineChart
                        android:id="@+id/chartEvolution"
                        android:layout_width="match_parent"
                        android:layout_height="240dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Charts Row: Radar + Complexity -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="16dp"
                android:weightSum="2">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardChartRadar"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="@color/card_bg"
                    app:strokeColor="@color/card_border"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="10dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="RADAR COMPETENCIAS"
                                android:textColor="@color/primary"
                                android:textSize="10sp"
                                android:textStyle="bold"
                                android:letterSpacing="0.05" />

                            <ImageButton
                                android:id="@+id/btnExpandRadar"
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:background="?selectableItemBackgroundBorderless"
                                android:src="@drawable/ic_expand"
                                android:contentDescription="Expandir"
                                android:padding="4dp" />
                        </LinearLayout>

                        <com.github.mikephil.charting.charts.RadarChart
                            android:id="@+id/chartRadar"
                            android:layout_width="match_parent"
                            android:layout_height="220dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardChartComplejidad"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="@color/card_bg"
                    app:strokeColor="@color/card_border"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="10dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="COMPLEJIDAD DE CASOS"
                                android:textColor="@color/primary"
                                android:textSize="10sp"
                                android:textStyle="bold"
                                android:letterSpacing="0.05" />

                            <ImageButton
                                android:id="@+id/btnExpandComplejidad"
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:background="?selectableItemBackgroundBorderless"
                                android:src="@drawable/ic_expand"
                                android:contentDescription="Expandir"
                                android:padding="4dp" />
                        </LinearLayout>

                        <com.github.mikephil.charting.charts.PieChart
                            android:id="@+id/chartComplejidad"
                            android:layout_width="match_parent"
                            android:layout_height="220dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- Times Bar Chart -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardChartTiempos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/card_bg"
                app:strokeColor="@color/card_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="TIEMPOS (OBSERVACIÓN vs FEEDBACK)"
                            android:textColor="@color/primary"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.05" />

                        <ImageButton
                            android:id="@+id/btnExpandTimes"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="?selectableItemBackgroundBorderless"
                            android:src="@drawable/ic_expand"
                            android:contentDescription="Expandir"
                            android:padding="6dp" />
                    </LinearLayout>

                    <com.github.mikephil.charting.charts.BarChart
                        android:id="@+id/chartTiempos"
                        android:layout_width="match_parent"
                        android:layout_height="220dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Areas to Improve -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardAreasMejora"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/card_bg"
                app:strokeColor="@color/card_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="ÁREAS DE MEJORA RECURRENTES"
                            android:textColor="@color/primary"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.05" />

                        <ImageButton
                            android:id="@+id/btnExpandAreas"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="?selectableItemBackgroundBorderless"
                            android:src="@drawable/ic_expand"
                            android:contentDescription="Expandir"
                            android:padding="6dp" />
                    </LinearLayout>

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chipGroupMejoras"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:chipSpacing="8dp"
                        app:singleLine="false" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Per-student buttons: Viewer + XLSX Download -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="horizontal"
                android:gravity="center">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnViewerStudentFullScreen"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:text="Ver en Pantalla Completa"
                    android:textAllCaps="false"
                    android:textSize="11sp"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    app:icon="@drawable/ic_reports"
                    app:iconTint="@color/primary"
                    app:strokeColor="@color/primary" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDownloadStudentXlsx"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:text="Descargar .xlsx"
                    android:textAllCaps="false"
                    android:textSize="11sp"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    app:icon="@drawable/ic_download"
                    app:iconTint="@color/primary"
                    app:strokeColor="@color/primary" />
            </LinearLayout>

            <!-- Student Summary List (teacher summary mode) -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvStudentSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:nestedScrollingEnabled="false"
                android:layout_marginTop="8dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
