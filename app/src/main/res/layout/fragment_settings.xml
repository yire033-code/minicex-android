<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:fillViewport="true"
    tools:context=".ui.settings.SettingsFragment">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Header Section -->
    <TextView
        android:id="@+id/tvSettingsTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Ajustes de Perfil"
        android:textColor="@color/on_surface"
        android:textSize="32sp"
        android:fontFamily="sans-serif-condensed-medium"
        android:textStyle="bold"
        android:layout_marginBottom="24dp" />

    <!-- User Information Card -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="24dp"
        app:cardElevation="4dp"
        app:cardBackgroundColor="@color/card_bg"
        app:strokeColor="@color/card_border"
        app:strokeWidth="1dp"
        android:layout_marginBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Avatar Circle -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_gravity="center_horizontal"
                app:cardCornerRadius="36dp"
                app:cardBackgroundColor="@color/primary"
                app:strokeWidth="0dp"
                android:layout_marginBottom="16dp">
                <TextView
                    android:id="@+id/tvAvatarText"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="D"
                    android:textColor="@android:color/white"
                    android:textSize="30sp"
                    android:textStyle="bold" />
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/tvUserName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Nombre del Docente"
                android:textColor="@color/on_surface"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textAlignment="center"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:id="@+id/tvUserEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="correo@upe.edu.mx"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:textAlignment="center"
                android:layout_marginBottom="8dp"/>

            <com.google.android.material.chip.Chip
                android:id="@+id/chipUserRole"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text="Docente"
                app:chipBackgroundColor="@color/accent_soft"
                android:textColor="@color/primary"
                app:chipStrokeWidth="0dp" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Actions Section -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Acciones del Sistema"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        android:textStyle="bold"
        android:letterSpacing="0.05"
        android:textAllCaps="true"
        android:layout_marginBottom="8dp" />

    <!-- Manual Sync Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnManualSync"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="Sincronizar Datos Ahora"
        app:icon="@drawable/ic_sync"
        app:cornerRadius="16dp"
        android:layout_marginBottom="16dp"
        app:strokeColor="@color/primary"/>

    <!-- Logout Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnLogout"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="Cerrar Sesión"
        app:icon="@drawable/ic_logout"
        app:cornerRadius="16dp"
        app:backgroundTint="#EF4444"
        android:textColor="@android:color/white"/>

    <TextView
        android:id="@+id/text_settings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="MINI-CEX v1.4.0 • Offline-First\n\nDesarrollador y Arquitecto:\nYire Abdiel Ramirez Sanchez\n\nInstitución:\nGrupo Educativo Siglo XXI\n\n© 2026. Todos los derechos reservados."
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        android:textAlignment="center"
        android:lineSpacingMultiplier="1.2"
        android:layout_marginTop="32dp"
        android:layout_marginBottom="24dp" />

</LinearLayout>
</ScrollView>
